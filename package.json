{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5186 --host 0.0.0.0 --strictPort",
    "build": "svelte-check --tsgo --tsconfig ./tsconfig.app.json && tsc --noEmit -p tsconfig.app.json && vite build",
    "check:ts": "tsc --noEmit -p tsconfig.app.json",
    "lint": "oxlint",
    "ui:add": "shadcn-svelte add",
    "preview": "vite preview --port 5185 --host 0.0.0.0 --strictPort",
    "start": "vite preview --port 5185 --host 0.0.0.0 --strictPort",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.app.json",
    "test:qr": "bun run scripts/qr-decode-test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ci": "PLAYWRIGHT_MANAGED_SERVERS=1 playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/svelte": "^1.54.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@napi-rs/canvas": "^1.0.10",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@typescript/native": "npm:typescript@7",
    "bits-ui": "^2.18.0",
    "oxlint": "^1.81.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.39.0",
    "svelte-check": "^4.3.0",
    "typescript": "~6",
    "vite": "^8.3.0"
  }
}
