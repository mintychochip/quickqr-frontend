{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5186 --host 0.0.0.0 --strictPort",
    "build": "svelte-check --tsgo --tsconfig ./tsconfig.app.json && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.edge.json && vite build && cp dist/index.html dist/privacy.html && cp dist/index.html dist/terms.html",
    "check:ts": "tsc --noEmit -p tsconfig.app.json",
    "check:edge": "tsc --noEmit -p tsconfig.edge.json",
    "test:edge": "bun test edge",
    "deploy:staging": "bun run build && rm -rf staging/out && cp -r dist staging/out && bunx wrangler pages functions build functions --outdir staging/out/_worker.js && printf '/privacy /privacy.html 200\\n/terms /terms.html 200\\n' >> staging/out/_redirects && cd staging && bunx wrangler pages deploy out --project-name quickqr-staging --branch main",
    "lint": "oxlint",
    "preview": "vite preview --port 5185 --host 0.0.0.0 --strictPort",
    "start": "vite preview --port 5185 --host 0.0.0.0 --strictPort",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.app.json",
    "test:qr": "bun run scripts/qr-decode-test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ci": "PLAYWRIGHT_MANAGED_SERVERS=1 playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/svelte": "^1.54.0",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@internationalized/date": "^3.12.0",
    "@napi-rs/canvas": "^1.0.10",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/bun": "^1.4.3",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@typescript/native": "npm:typescript@7",
    "bits-ui": "^2.18.0",
    "oxlint": "^1.81.0",
    "pngjs": "^7.0.0",
    "svelte": "^5.39.0",
    "svelte-check": "^4.3.0",
    "typescript": "~6",
    "vite": "^8.3.0"
  }
}
